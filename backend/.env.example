# ─── Database ────────────────────────────────────────────────────────────────
# Get this from Render PostgreSQL or Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret_string"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL="https://your-app.vercel.app"

# ─── Migration (optional, only needed for migrate-sqlite.js) ─────────────────
MIGRATION_EMAIL="admin@shira.local"
MIGRATION_NAME="Admin"
MIGRATION_PASS="changeme123"
